---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';
---

<html lang="ja" class="dark min-h-screen bg-[#111111] text-[#ffffff]">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Profile | {siteConfig.siteTitle}</title>
    <meta name="description" content={`Profile of ${siteConfig.author.name}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-[#111111] text-white antialiased">
    <SiteHeader />

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-12 sm:py-16">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Profile
      </h1>
      <section
        class="mt-8 min-h-80 rounded-xl border border-[#737d82]/30 bg-[#24242d]"
        aria-label="Profile content"
      >
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
