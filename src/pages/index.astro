---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';

const posts = await getCollection('externalArticles');
posts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const articleCount = posts.filter(
  (p) => p.data.contentType === 'article'
).length;
const slideCount = posts.filter((p) => p.data.contentType === 'slide').length;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>tk3fftk - Activity & External Articles</title>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <div class="header-content">
          <h1 class="site-title">tk3fftk</h1>
          <p class="site-desc">
            Zenn, note, Qiita, Speaker Deck
            の投稿を集約したタイムライン（仮デザイン）
          </p>
          <div class="stats-bar">
            <span class="stat-badge">Total: {posts.length}</span>
            <span class="stat-badge stat-article">Articles: {articleCount}</span
            >
            <span class="stat-badge stat-slide">Slides: {slideCount}</span>
          </div>
        </div>
      </header>

      <main class="main-content">
        {
          posts.length === 0 ? (
            <p class="empty-state">No articles found.</p>
          ) : (
            <div class="posts-grid">
              {posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          )
        }
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} tk3fftk. Built with Astro.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  body {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
    background-color: #f8fafc;
    color: #1e293b;
    line-height: 1.5;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .site-title {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .site-desc {
    margin: 0 0 1rem;
    color: #64748b;
    font-size: 0.95rem;
  }

  .stats-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stat-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    background-color: #f1f5f9;
    color: #475569;
  }

  .stat-article {
    background-color: #e0f2fe;
    color: #0369a1;
  }

  .stat-slide {
    background-color: #fef3c7;
    color: #b45309;
  }

  .main-content {
    flex: 1;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty-state {
    text-align: center;
    color: #94a3b8;
    padding: 3rem 0;
  }

  .site-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
    text-align: center;
    color: #94a3b8;
    font-size: 0.85rem;
  }
</style>
