---
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import PostList from '../components/PostList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../config/site';
import { createUnifiedPosts } from '../utils/posts';
import '../styles/global.css';

const [externalArticles, diaryEntries] = await Promise.all([
  getCollection('externalArticles'),
  getCollection('diary'),
]);

const posts = createUnifiedPosts(externalArticles, diaryEntries);
---

<html lang="ja" class="dark min-h-screen bg-[#111111] text-[#ffffff]">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteConfig.siteTitle}</title>
    <meta name="description" content={siteConfig.siteDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-[#111111] text-white antialiased">
    <SiteHeader />

    <main class="mx-auto w-full max-w-6xl flex-1 px-4">
      <ProfileHeader />

      <div class="mb-6 border-t border-[#737d82]/30 pt-8">
        <PostList posts={posts} initialCount={24} incrementCount={24} />
      </div>
    </main>

    <SiteFooter />
  </body>
</html>
