---
import { getCollection } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SpeakerDeckSlideList from '../components/SpeakerDeckSlideList.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';
import { createUnifiedPosts } from '../utils/posts';

const [externalArticles, diaryEntries] = await Promise.all([
  getCollection('externalArticles'),
  getCollection('diary'),
]);
const posts = createUnifiedPosts(externalArticles, diaryEntries).filter(
  (post) => post.contentType === 'slide' && post.platform === 'speakerdeck'
);
---

<html lang="ja" class="dark min-h-screen bg-[#111111] text-[#ffffff]">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Slide | {siteConfig.siteTitle}</title>
    <meta name="description" content="Slides by Hiroki Takatsuka" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-[#111111] text-white antialiased">
    <SiteHeader />

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-12 sm:py-16">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Slide
      </h1>
      <div class="mt-8 border-t border-[#737d82]/30 pt-8">
        <SpeakerDeckSlideList posts={posts} />
      </div>
    </main>

    <SiteFooter />
  </body>
</html>
