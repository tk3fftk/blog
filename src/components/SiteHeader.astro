---
import { siteConfig } from '../config/site';

const navigationItems = [
  { href: '/article', label: 'Article' },
  { href: '/slide', label: 'Slide' },
  { href: '/diary', label: 'Diary' },
  { href: '/profile', label: 'Profile' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="sticky top-0 z-50 border-b border-[#737d82]/20 bg-[#111111]/90 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4">
    <a
      href="/"
      class="text-xl font-bold tracking-tight text-white transition-colors hover:text-[#b494ff]"
    >
      {siteConfig.siteTitle}
    </a>

    <nav
      class="min-w-0 flex-1 [scrollbar-width:none] overflow-x-auto [&::-webkit-scrollbar]:hidden"
      aria-label="Main navigation"
    >
      <ul class="flex w-max items-center gap-4 text-sm font-medium sm:gap-5">
        {
          navigationItems.map(({ href, label }) => {
            const isCurrentPage = currentPath === href;

            return (
              <li>
                <a
                  href={href}
                  aria-current={isCurrentPage ? 'page' : undefined}
                  class:list={[
                    'transition-colors hover:text-white',
                    isCurrentPage ? 'text-[#b494ff]' : 'text-[#d4e7f1]/70',
                  ]}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex flex-shrink-0 items-center">
      {
        siteConfig.socialLinks.github_repo && (
          <a
            href={siteConfig.socialLinks.github_repo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#d4e7f1]/70 transition-colors hover:text-white"
            aria-label="GitHub Repository"
          >
            <svg
              class="h-5 w-5 fill-current"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</header>
