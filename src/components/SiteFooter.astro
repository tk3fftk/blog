---
import { siteConfig } from '../config/site';
const currentYear = new Date().getFullYear();
---

<footer
  class="mt-20 border-t border-[#737d82]/20 py-8 text-center text-xs text-[#d4e7f1]/60"
>
  <div class="mx-auto max-w-6xl px-4">
    <p>© {currentYear} {siteConfig.author.name}. Built with Astro.</p>
  </div>
</footer>
