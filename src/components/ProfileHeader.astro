---
import { siteConfig } from '../config/site';
const { author, socialLinks } = siteConfig;
---

<section class="py-10 text-center">
  <div class="relative inline-block">
    <img
      src={author.avatarSrc}
      alt={author.name}
      width="100"
      height="100"
      class="mx-auto h-[100px] w-[100px] rounded-2xl border border-[#737d82]/30 object-cover shadow-md"
      loading="eager"
    />
  </div>

  <h1 class="mt-4 text-2xl font-bold tracking-tight text-white">
    {author.name}
  </h1>

  {
    author.bio && (
      <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-[#d4e7f1]/80">
        {author.bio}
      </p>
    )
  }

  <div class="mt-4 flex items-center justify-center gap-3">
    {
      socialLinks.twitter && (
        <a
          href={socialLinks.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#737d82]/20 bg-[#24242d] text-[#d4e7f1] transition-colors hover:bg-[#2e2e3a] hover:text-white"
          aria-label="Follow on X"
        >
          <svg
            class="h-4 w-4 fill-current"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
      )
    }
    {
      socialLinks.github && (
        <a
          href={socialLinks.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#737d82]/20 bg-[#24242d] text-[#d4e7f1] transition-colors hover:bg-[#2e2e3a] hover:text-white"
          aria-label="GitHub Profile"
        >
          <svg
            class="h-5 w-5 fill-current"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
        </a>
      )
    }
  </div>
</section>
